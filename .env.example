NODE_ENV = production

APP_PROTOCOL = https
APP_HOST = api.example.com
APP_PORT = 8008
# Local development only. In docker compose MONGO_URL is built from MONGO_USER/MONGO_PASSWORD below.
MONGO_URL = mongodb://localhost:27017/babyland

# Mongo root credentials (docker compose). Use letters/digits only in the password, or URL-encode it.
MONGO_USER = babyland
MONGO_PASSWORD = <strong_password>

# Bind address for the app port: 0.0.0.0 = public, 127.0.0.1 = only behind nginx on the same server
APP_BIND = 0.0.0.0

JWT_SECRET = <long_random_string>
JWT_TOKEN_EXPIRE_SECONDS = 1000
SESSION_STORE_SECRET = <long_random_string>

IMAGES_FOLDER_NAME = images
IMAGES_END_POINT = https://api.example.com

LOGIN = <some_login>
PASSWORD = <some_password>
